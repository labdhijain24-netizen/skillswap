{
  "name": "skillswap-monorepo",
  "version": "1.0.0",
  "description": "SkillSwap - A peer-to-peer skill exchange platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "db:verify": "npm run db:verify --prefix backend",
    "build:frontend": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "skillswap",
    "react",
    "express",
    "supabase",
    "tailwind"
  ],
  "author": "",
  "license": "ISC"
}
